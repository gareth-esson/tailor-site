---
import '../styles/tailwind.css';
import '../styles/tailor-site-v2.css';
// Self-hosted Lexend (used sitewide). Replaces the Google Fonts CSS
// fetch — saves the round-trip to fonts.googleapis.com on first paint
// and the woff2 round-trip to fonts.gstatic.com that the CSS triggers.
// Each import is one weight × all three Latin subsets (vietnamese,
// latin-ext, latin) — the browser fetches only the subset it needs
// based on unicode-range. Atkinson Hyperlegible + Fraunces (OtA only)
// stay on Google Fonts for now: smaller impact, and they're already
// conditional on layer="ota".
import '@fontsource/lexend/400.css';
import '@fontsource/lexend/600.css';
import '@fontsource/lexend/700.css';
// Stable hashed URL for Lexend 600 latin — used in <link rel="preload">
// below so the LCP heading font starts fetching at HTML parse time.
import lexend600LatinUrl from '@fontsource/lexend/files/lexend-latin-600-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Analytics from '../components/Analytics.astro';
import {
  site,
  assets,
  organisationJsonLd,
  websiteJsonLd,
} from '../lib/site';

interface ArticleMeta {
  /** ISO 8601 — emitted as og:article:published_time. */
  publishedTime?: string;
  /** ISO 8601 — og:article:modified_time. Falls back to publishedTime
   *  if not provided so the meta is always present for articles. */
  modifiedTime?: string;
  /** Plain author name. og:article:author. */
  author?: string;
  /** Top-level category — og:article:section. */
  section?: string;
}

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  /** When ogType is 'article', supply this for richer social cards
   *  (LinkedIn shows author + date, Facebook prioritises article meta). */
  articleMeta?: ArticleMeta;
  layer?: 'tailor' | 'ota';
  /** Page-specific JSON-LD. Sitewide Organization (and WebSite on the
   *  homepage) is always emitted in addition. */
  jsonLd?: Record<string, unknown>;
  noIndex?: boolean;
  /**
   * URL of an image that is the likely LCP element on the page.
   * Emitted as <link rel="preload" as="image"> so the browser can
   * start fetching it before CSS/JS resolve. Use for above-the-fold
   * hero images only.
   */
  preloadImage?: string;
}

const {
  title,
  description = site.defaultDescription,
  canonicalPath,
  ogImage = assets.ogDefault,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  articleMeta,
  layer = 'tailor',
  jsonLd,
  noIndex = false,
  preloadImage,
} = Astro.props;

// Resolve modifiedTime to publishedTime so the meta is always present
// when ogType is 'article'. (Some social platforms only show "Updated"
// labels when modified_time differs.)
const articlePublishedTime = articleMeta?.publishedTime;
const articleModifiedTime = articleMeta?.modifiedTime ?? articleMeta?.publishedTime;

// Single source of truth: `site:` in astro.config.mjs → Astro.site.
// Fallback only if the config hasn't been set (shouldn't happen in prod).
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? site.url;

// Vercel is configured with `trailingSlash: true` — every page URL ends
// with `/`. Canonicals must match the served URL exactly; otherwise
// Google treats the canonical as pointing to a 308-redirect target,
// which it then either follows (wasting equity) or ignores entirely.
// Normalise here so individual pages don't have to remember.
function normaliseCanonical(path: string): string {
  if (/\.[a-zA-Z0-9]+$/.test(path)) return path; // file extension — leave alone
  if (path.endsWith('/')) return path;
  return `${path}/`;
}

const rawPath = canonicalPath ?? Astro.url.pathname;
const canonical = `${siteUrl}${normaliseCanonical(rawPath)}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Default OG image dimensions when the page hasn't overridden them.
const isDefaultOg = ogImage === assets.ogDefault;
const finalOgWidth = ogImageWidth ?? (isDefaultOg ? assets.ogDefaultWidth : undefined);
const finalOgHeight = ogImageHeight ?? (isDefaultOg ? assets.ogDefaultHeight : undefined);

const ga4Id = import.meta.env.GA4_MEASUREMENT_ID || '';

// Defend against `</script>` smuggling in Notion-authored content.
const escapeJsonForScript = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c');

// Sitewide structured data: Organization always, WebSite on homepage.
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '';
const sitewideJsonLd: Record<string, unknown> = isHomepage
  ? {
      '@context': 'https://schema.org',
      '@graph': [organisationJsonLd(), websiteJsonLd()],
    }
  : organisationJsonLd();
---

<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a9e8a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    {finalOgWidth && <meta property="og:image:width" content={String(finalOgWidth)} />}
    {finalOgHeight && <meta property="og:image:height" content={String(finalOgHeight)} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content={site.ogLocale} />

    {ogType === 'article' && articleMeta && (
      <Fragment>
        {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
        {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
        {articleMeta.author && <meta property="article:author" content={articleMeta.author} />}
        {articleMeta.section && <meta property="article:section" content={articleMeta.section} />}
      </Fragment>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Sitewide structured data — Organization on every page, WebSite on
         the homepage. Page-specific jsonLd is emitted as a second tag below;
         multiple ld+json scripts on one page is valid and Google merges. -->
    <script type="application/ld+json" set:html={escapeJsonForScript(sitewideJsonLd)} />

    <!-- Page-specific JSON-LD. -->
    {jsonLd && (
      <script type="application/ld+json" set:html={escapeJsonForScript(jsonLd)} />
    )}

    <!-- Simple Mode: check preference before first paint to prevent flash of wrong content -->
    <script is:inline>
      if (localStorage.getItem('simple_mode') === 'true') {
        document.documentElement.classList.add('simple-active');
      }
    </script>

    <!--
         Font loading.

         Lexend (Tailor body + headings) is now self-hosted via
         @fontsource/lexend, imported in the frontmatter. Vite bundles
         the woff2 files into /_astro/ with hashed filenames and emits
         the @font-face rules into the page's main CSS bundle — so the
         font CSS is part of the same render-blocking stylesheet that
         already loads for layout. No extra round-trip.

         The 600 weight (LCP heading) is preloaded explicitly below so
         the browser starts fetching the woff2 at HTML parse time
         instead of waiting for the CSS to be parsed.

         Atkinson Hyperlegible (OtA body) and Fraunces (OtA headings)
         remain on Google Fonts — only loaded when the page declares
         the OtA layer. Each stylesheet is loaded as media=print then
         promoted to all onload so the fetch doesn't block first paint.
         display=swap keeps text visible with a fallback while the
         webfont downloads. A noscript fallback handles users with JS
         disabled.

         IMPORTANT: never write a literal less-than-sign + tag-name
         inside this comment — Astro's HTML compiler parses the comment
         body and treats it as an unclosed tag, which silently breaks
         page structure (Pagefind indexed 0 pages on the first build
         that did this).
    -->
    <link rel="preload" as="font" type="font/woff2" href={lexend600LatinUrl} crossorigin />
    {layer === 'ota' && (
      <Fragment>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&display=swap" />
        <link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,14..72,400..700;1,14..72,400..700&display=swap" />
      </Fragment>
    )}
    <!-- noscript fallback for OtA Google Fonts only — Lexend is self-
         hosted now and bundled into the main CSS, so JS-disabled users
         already get it. Fonts loaded unconditionally regardless of
         layer because conditional rendering inside <noscript> triggers
         an Astro compiler bug (broken HTML structure → 0 pages indexed
         by Pagefind). Cost is small: one extra OFL stylesheet on
         Tailor pages for the rare no-JS visitor. -->
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&display=swap" />
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,14..72,400..700;1,14..72,400..700&display=swap" />
    </noscript>


    <!-- GA4 -->
    {ga4Id && (
      <Fragment>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4Id);
          window.gtag = gtag;
        </script>
      </Fragment>
    )}
  </head>
  <body>
    <SiteHeader />

    <main id="main" class:list={[layer === 'ota' && 'layer-ota']}>
      <slot />
    </main>

    <SiteFooter />
    <Analytics />

    <!-- Analytics helper -->
    <script is:inline>
      window.trackEvent = function(eventName, params) {
        if (typeof window.gtag === 'function') {
          window.gtag('event', eventName, params);
        }
      };
    </script>
  </body>
</html>
