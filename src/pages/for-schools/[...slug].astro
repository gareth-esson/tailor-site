---
/**
 * Cluster page template [C6] — /for-schools/{slug}
 *
 * A product page for one topic. The topic is the thing being sold; the two
 * ways to buy it are delivery (we teach it) and training (your staff do).
 * Everything else on the page exists to make a PSHE lead confident enough
 * to enquire: the approach shows we have thought about how to teach it, the
 * sample unit shows what that looks like lesson by lesson, the guidance
 * shows we write about it, and the handed-in questions show we hear from
 * the pupils it concerns.
 *
 * Not a topic page. /topics/{slug} is the taxonomy that 152 questions,
 * 145 glossary terms and the curriculum mapping roll up into, and it stays
 * exactly as it is. This page cross-links down to it and sells against it.
 *
 * Section order:
 *   §1 Hero
 *   §2 How we can help — the two routes, bookable, with the adaptation
 *      promise stated plainly. A sequence presented as fixed sells to
 *      fewer schools than the same sequence presented as a starting point.
 *   §3 Our approach (MDX body)
 *   §4 The sample unit — lessons carry their own download when one exists
 *   §5 Guidance we have published
 *   §7 What pupils actually asked — QuestionCard, the same component the
 *      topic pages and tag archives use, so a handed-in note looks and
 *      behaves identically wherever it appears
 *   §8 Related topics — ServiceTopicsStrip, shared with the service pages
 *
 * Carries no statutory claim of its own; `statutoryNote` names the guidance
 * in general terms and the linked posts hold the citations.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import ServiceTopicsStrip from '../../components/ServiceTopicsStrip.astro';
import ServiceMetaStrip from '../../components/ServiceMetaStrip.astro';
import ClusterOfferRoutes from '../../components/ClusterOfferRoutes.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import { getQuestions, getBlogPosts, getTestimonialsByService } from '../../lib/content';
import { serviceCta } from '../../lib/enquiry-services.js';
import { breadcrumbJsonLd, serviceJsonLd } from '../../lib/site';

export const prerender = true;

export async function getStaticPaths() {
  const clusters = (await getCollection('clusters')).filter(
    (c) => c.data.status === 'Published',
  );
  const [questions, posts] = await Promise.all([getQuestions(), getBlogPosts()]);

  return Promise.all(
    clusters.map(async (cluster) => {
      // Resolve by slug. Anything that no longer resolves is dropped and
      // warned rather than rendered dead — silence here would mean a
      // section quietly shrinking with nobody noticing.
      const pick = (slugs: string[], pool: any[], kind: string) =>
        slugs
          .map((slug) => {
            const hit = pool.find((item) => item.slug === slug);
            if (!hit) console.warn(`[cluster:${cluster.id}] ${kind} not found: ${slug}`);
            return hit;
          })
          .filter(Boolean);

      return {
        params: { slug: cluster.id },
        props: {
          cluster,
          // Passed straight to QuestionCard, which resolves the post-it
          // scan itself and omits the image when a question has none.
          questions: pick(cluster.data.questionSlugs, questions, 'question'),
          posts: pick(cluster.data.postSlugs, posts, 'post'),
        },
      };
    }),
  );
}

const { cluster, questions, posts } = Astro.props;
const { data } = cluster;
const { Content } = await render(cluster);

const canonicalPath = `/for-schools/${cluster.id}/`;
const closingCta = serviceCta(data.serviceCtaTarget);

// The two ways to buy this topic. Same vocabulary as everywhere else, so
// the enquiry arrives with the service already chosen.
const delivery = serviceCta('delivery');
const training = serviceCta('training');
const routes = [
  {
    kicker: 'We teach it',
    title: 'RSE delivery in your classrooms',
    text: 'A specialist takes the lessons with your pupils, so the hardest sessions are led by someone who teaches them every week.',
    cta: delivery,
    label: 'Talk to us about delivery',
  },
  {
    kicker: 'You teach it',
    title: 'Training for your staff',
    text: 'CPD that leaves your team able to teach this themselves, including what to do with the question nobody saw coming.',
    cta: training,
    label: 'Talk to us about training',
  },
];

// One relevant testimonial, by the cluster's own service tag. Proof sits
// beside the offer rather than at the foot, because the claim being made
// ("specialist RSE") is made there.
const [proofTestimonial] = data.testimonialTag
  ? await getTestimonialsByService(data.testimonialTag as any)
  : [];

// Both a Service and a BreadcrumbList. Without the Service node this reads
// to Google as an article, not a commercial page — every /services/ page
// emits one and this page sells the same two products.
const jsonLd = [
  serviceJsonLd({
    name: data.title,
    description: data.metaDescription,
    canonicalPath,
    serviceType: 'RSE delivery and training',
    enquiryValue: closingCta.param,
    audienceRoles: ['School leader', 'PSHE lead', 'Teacher'],
  }),
  breadcrumbJsonLd([
    { name: 'For schools', path: '/for-schools/' },
    { name: data.title, path: canonicalPath },
  ]),
];
---

<BaseLayout
  title={data.metaTitle || `${data.title} | Tailor RSE`}
  description={data.metaDescription}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <article class="cluster" data-pagefind-body>

    <!-- §1 Hero -->
    <header class="cluster-hero">
      <div class="cluster-hero__inner">
        <Breadcrumb
          trail={[
            { name: 'For schools', path: '/for-schools/' },
            { name: data.title, path: canonicalPath },
          ]}
        />
        <div class="cluster-hero__text">
          <h1 class="cluster-hero__title" data-pagefind-meta="title">{data.title}</h1>
          {data.lede && <p class="cluster-hero__lede">{data.lede}</p>}
          {data.statutoryNote && (
            <p class="cluster-hero__statutory">
              {data.statutoryHref ? (
                <a class="link-inline" href={data.statutoryHref} rel="noopener">
                  {data.statutoryNote}
                </a>
              ) : (
                data.statutoryNote
              )}
            </p>
          )}
          <p class="cluster-hero__credentials">
            Delivered by QTS-qualified RSE specialists. Tailor Learning is a
            community-interest company working in UK schools.
          </p>
        </div>
      </div>
    </header>

    <!-- §2 How we can help -->
    <div class="cluster-offer">
      <ClusterOfferRoutes
        headingId="cluster-routes-heading"
        heading="Two ways to get this taught"
        note="One lesson, a full sequence or a drop day. Everything is adapted to the year group, the prior knowledge in the room and what has already happened in your school."
      />
      {proofTestimonial && (
        <div class="cluster-offer__proof">
          <TestimonialCard testimonial={proofTestimonial} variant="band" />
        </div>
      )}
    </div>

    <!-- §3 Our approach -->
    <section class="cluster-body">
      <div class="cluster-body__inner">
        <Content />
      </div>
    </section>

    <!-- §4 The sample unit -->
    {data.unit && data.unit.lessons.length > 0 && (
      <section class="cluster-unit" aria-labelledby="cluster-unit-heading">
        <div class="cluster-unit__inner">
          <div class="cluster-unit__head">
            <h2 id="cluster-unit-heading" class="cluster-unit__title">{data.unit.title}</h2>
            {data.unit.intro && <p class="cluster-unit__intro">{data.unit.intro}</p>}
            {data.unit.arc.length > 0 && (
              <ol class="cluster-unit__arc" role="list">
                {data.unit.arc.map((step) => (
                  <li class="cluster-unit__arc-step">{step}</li>
                ))}
              </ol>
            )}
          </div>

          <ServiceMetaStrip
            ariaLabel="Sample unit at a glance"
            items={[
              ...(data.unit.yearGroup ? [{ label: 'Written for', value: data.unit.yearGroup }] : []),
              { label: 'Lessons', value: String(data.unit.lessons.length) },
              ...(data.unit.lessonLength ? [{ label: 'Each', value: data.unit.lessonLength }] : []),
            ]}
          />

          <ol class="cluster-unit__lessons">
            {data.unit.lessons.map((lesson, i) => (
              <li class="cluster-lesson">
                <span class="cluster-lesson__n" aria-hidden="true">{i + 1}</span>
                <div class="cluster-lesson__body">
                  <h3 class="cluster-lesson__title">{lesson.title}</h3>
                  <p class="cluster-lesson__question">{lesson.question}</p>
                  <p class="cluster-lesson__outcome">{lesson.outcome}</p>
                  {lesson.download && (
                    <a
                      class="link-action link-action--card cluster-lesson__download"
                      href={lesson.download.href}
                      data-analytics-event="cta_click"
                      data-analytics-cta-type="cluster_lesson_download"
                      data-analytics-target={lesson.download.href}
                    >
                      {lesson.download.format
                        ? `Download the plan (${lesson.download.format})`
                        : 'Download the plan'}
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <!-- §5 Conversion — the moment of maximum intent, both routes -->
    <ClusterOfferRoutes
      headingId="cluster-convert-heading"
      heading="Want this taught in your school?"
      note="Tell us the year group and where your pupils are starting from, and we will say what we would do."
    />

    <!-- §6 Guidance -->
    {posts.length > 0 && (
      <section class="cluster-guidance" aria-labelledby="cluster-guidance-heading">
        <div class="cluster-guidance__inner">
          <h2 id="cluster-guidance-heading" class="cluster-guidance__title">
            Guidance for teaching this
          </h2>
          <p class="cluster-guidance__intro">
            Written for the teacher taking the lesson, not for us. Free to
            read, and useful whether or not you ever book anything.
          </p>
          <ul class="cluster-guidance__grid" role="list">
            {posts.map((post: any) => (
              <li>
                <a href={`/blog/${post.slug}/`} class="card card--lift cluster-guidance-card">
                  {post.featuredImage && (
                    <div class="card__img cluster-guidance-card__img">
                      <img src={post.featuredImage} alt="" loading="lazy" />
                    </div>
                  )}
                  <div class="card__body">
                    {post.targetAudience && (
                      <div class="card__eyebrow">{post.targetAudience}</div>
                    )}
                    <h3 class="card__title">{post.title}</h3>
                    {post.metaDescription && (
                      <p class="card__text">{post.metaDescription}</p>
                    )}
                    <span class="card__link">Read it</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- §7 What pupils actually asked -->
    {questions.length > 0 && (
      <section class="cluster-asks" aria-labelledby="cluster-asks-heading">
        <div class="cluster-asks__inner">
          <h2 id="cluster-asks-heading" class="cluster-asks__title">
            These conversations are already happening
          </h2>
          <p class="cluster-asks__note">
            Questions pupils handed us anonymously, on paper, in schools we
            have worked in. Printed as they were written. Every one is
            answered in full on Okay to Ask.
          </p>
          <ul class="cluster-asks__grid" role="list">
            {questions.map((q: any) => (
              <li>
                <QuestionCard question={q} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- §8 Related topics — the shared strip the service pages and the
         homepage use, so a topic card looks the same everywhere. The
         commercial framing sits in the heading and intro; the buy actions
         live in §2 where actions belong. -->
    <ServiceTopicsStrip
      featuredSlugs={data.topicSlugs}
      heading="We teach these alongside it"
      intro="Any of these can be taught in your classrooms or built into staff training, on their own or as part of a longer sequence."
    />


  </article>
</BaseLayout>

<style>
  .cluster-hero__inner,
  .cluster-routes__inner,
  .cluster-body__inner,
  .cluster-unit__inner,
  .cluster-guidance__inner,
  .cluster-asks__inner {
    max-width: var(--container-max-shell);
    margin-inline: auto;
    padding-inline: var(--space-global-gutter);
  }

  /* §1 Hero ---------------------------------------------------- */

  .cluster-hero__inner {
    padding-block: var(--space-struct-y-hero) var(--space-global-xl);
  }

  .cluster-hero__text {
    max-width: var(--container-max-hero-text);
  }

  .cluster-hero__title {
    font-family: var(--font-tailor-heading-stack);
    font-size: var(--text-display-size-h1);
    font-weight: var(--heading-weight-h1);
    line-height: var(--lh-heading);
    color: var(--text-heading);
    text-wrap: balance;
    margin: 0 0 var(--space-global-md);
  }

  .cluster-hero__lede {
    font-size: var(--text-prose-size-lede);
    line-height: var(--lh-prose);
    color: var(--text-body);
    margin: 0;
  }

  /* A marker, not a banner: a hairline and a size step down keep the
     statutory line available without letting it lead the page. */
  .cluster-hero__statutory {
    margin: var(--space-global-lg) 0 0;
    padding-top: var(--space-global-sm);
    border-top: var(--border-width-xs) solid var(--border-subtle);
    font-size: var(--text-card-size-body);
    color: var(--text-body-muted);
  }

  /* §2 Offer ------------------------------------------------- */

  .cluster-offer {
    background: var(--bg-surface-alt);
  }

  /* The proof sits inside the offer band, directly under the two routes,
     so the claim and the evidence for it are read together. */
  .cluster-offer__proof {
    max-width: var(--container-max-shell);
    margin-inline: auto;
    padding-inline: var(--space-global-gutter);
    padding-bottom: var(--space-struct-y-base);
  }

  .cluster-hero__credentials {
    max-width: var(--container-max-hero-text);
    margin: var(--space-global-sm) 0 0;
    font-size: var(--text-card-size-body);
    color: var(--text-body-muted);
  }

  /* §3 Approach ------------------------------------------------ */

  .cluster-body__inner {
    max-width: var(--container-max-prose);
    margin-inline: auto;
    padding-block: var(--space-struct-y-base);
  }

  /* §4 The sample unit ----------------------------------------- */

  .cluster-unit__inner {
    padding-block: 0 var(--space-struct-y-base);
  }

  .cluster-unit__head {
    max-width: var(--container-max-hero-text);
    margin-bottom: var(--space-global-lg);
  }

  .cluster-unit__title {
    font-family: var(--font-tailor-heading-stack);
    font-size: var(--text-display-size-h2);
    font-weight: var(--heading-weight-h2);
    color: var(--text-heading);
    margin: 0 0 var(--space-global-sm);
  }

  .cluster-unit__intro {
    font-size: var(--text-prose-size-body);
    line-height: var(--lh-prose);
    color: var(--text-body-muted);
    margin: 0;
  }

  /* The arc is the unit's argument in five words, so a reader who skips
     the six lessons still sees the progression. */
  .cluster-unit__arc {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-global-xs) var(--space-global-sm);
    margin: var(--space-global-lg) 0 0;
    padding: 0;
  }

  .cluster-unit__arc-step {
    font-size: var(--text-card-size-body);
    font-weight: var(--font-weight-semibold);
    color: var(--text-heading);
  }

  .cluster-unit__arc-step + .cluster-unit__arc-step::before {
    content: '\2192';
    margin-right: var(--space-global-sm);
    color: var(--text-body-muted);
    font-weight: var(--font-weight-regular);
  }

  .cluster-unit__lessons {
    list-style: none;
    margin: var(--space-global-lg) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-global-md);
  }

  .cluster-lesson {
    display: flex;
    gap: var(--space-global-md);
    padding: var(--space-global-lg);
    background: var(--bg-surface);
    border: var(--border-width-xs) solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .cluster-lesson__n {
    flex-shrink: 0;
    font-family: var(--font-tailor-heading-stack);
    font-size: var(--text-display-size-h3);
    font-weight: var(--heading-weight-h3);
    line-height: 1;
    color: var(--brand-accent);
  }

  .cluster-lesson__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-global-xs);
  }

  .cluster-lesson__title {
    font-family: var(--font-tailor-heading-stack);
    font-size: var(--text-card-size-h3);
    font-weight: var(--heading-weight-h3);
    color: var(--text-heading);
    margin: 0;
  }

  /* The pupil-facing question is what a PSHE lead scans for, so it takes
     the weight and the teacher-facing outcome sits under it. */
  .cluster-lesson__question {
    font-size: var(--text-prose-size-body);
    font-weight: var(--font-weight-semibold);
    line-height: var(--lh-prose);
    color: var(--text-heading);
    margin: 0;
  }

  .cluster-lesson__outcome {
    font-size: var(--text-card-size-body);
    line-height: var(--lh-prose);
    color: var(--text-body-muted);
    margin: 0;
  }

  .cluster-lesson__download {
    margin-top: var(--space-global-xs);
  }

  /* §5 Guidance ------------------------------------------------ */

  .cluster-guidance {
    background: var(--bg-surface-alt);
  }

  .cluster-guidance__inner {
    padding-block: var(--space-struct-y-base);
  }

  .cluster-guidance__title {
    font-family: var(--font-tailor-heading-stack);
    font-size: var(--text-display-size-h2);
    font-weight: var(--heading-weight-h2);
    color: var(--text-heading);
    margin: 0 0 var(--space-global-xs);
  }

  .cluster-guidance__intro {
    max-width: var(--container-max-hero-text);
    font-size: var(--text-card-size-body);
    color: var(--text-body-muted);
    margin: 0 0 var(--space-global-lg);
  }

  .cluster-guidance__grid,
  .cluster-asks__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-global-md);
    grid-template-columns: 1fr;
    align-items: start;
  }

  /* Same shape the service pages use for related articles: the system
     .card carries the structure, the modifier only sizes the image. These
     posts are the free half of the offer, so they get pictures and an
     excerpt rather than being a list of links under the paid part. */
  .cluster-guidance-card {
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .cluster-guidance-card__img {
    aspect-ratio: 16 / 9;
    background: var(--bg-surface-alt);
  }

  /* §6 Handed-in questions ------------------------------------- */

  .cluster-asks__inner {
    padding-block: var(--space-struct-y-base);
  }

  .cluster-asks__title {
    font-family: var(--font-tailor-heading-stack);
    font-size: var(--text-display-size-h2);
    font-weight: var(--heading-weight-h2);
    color: var(--text-heading);
    margin: 0 0 var(--space-global-xs);
  }

  .cluster-asks__note {
    max-width: var(--container-max-hero-text);
    font-size: var(--text-card-size-body);
    color: var(--text-body-muted);
    margin: 0 0 var(--space-global-lg);
  }

  @media (min-width: 640px) { /* --bp-md */
    .cluster-routes__grid,
    .cluster-asks__grid,
    .cluster-guidance__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) { /* --bp-lg */
    .cluster-asks__grid,
    .cluster-guidance__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
