---
/**
 * Service page [C5] — /services/rse-training
 * RSE training for school staff. Tailor layer, v3.
 * Highest-traffic service page. Richest content.
 * Replaces the old standalone /rse-training (B4) page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroImage from '../../components/HeroImage.astro';
import { heroPreload } from '../../lib/hero-image';
import CtaServiceEnquiry from '../../components/CtaServiceEnquiry.astro';
import ServiceFaq from '../../components/ServiceFaq.astro';
import ServiceMetaStrip from '../../components/ServiceMetaStrip.astro';
import ServiceTopicsStrip from '../../components/ServiceTopicsStrip.astro';
import { getBlogPosts, getTestimonialsByService } from '../../lib/content';
import { serviceJsonLd, breadcrumbJsonLd, faqJsonLd } from '../../lib/site';

// --- Data ----------------------------------------------------------
const slug = 'rse-training';
// `title` is the short label used in the breadcrumb and meta strings.
// `pageHeading` is the keyword-rich H1; competing against PSHE Association
// and Brook on "RSE staff training" needs more than a two-word heading.
const title = 'RSE training';
const pageHeading = 'RSE training for school staff';
const serviceParam = 'RSE training';
const serviceName = 'RSE training';

const heroSubtitle =
  'Training that gives your staff the confidence, knowledge, and practical toolkit to deliver RSE well. Half-day, full-day, or bespoke programmes, delivered in person, led by a specialist who has delivered it in hundreds of schools.';

const heroImage: string | null = '/images/services/tailor-education-rse-cpd-workshop-facilitator.webp';
const heroImageAlt = 'A Tailor facilitator leading a CPD workshop for school staff on RSE delivery';
const heroImageWidth = 1600;
const heroImageHeight = 872;

// §3 description heading — edit per-page for a tailored intro.
const descriptionHeading = 'About RSE Training';

const descriptionLead =
  'The biggest barrier to good RSE in most schools isn\'t policy or curriculum, it\'s teacher confidence. Staff are asked to deliver topics they were never trained in, sometimes with a few hours\' notice, often with no clear framework for what to say when a student asks the question they were dreading.';

const descriptionBody = [
  'Our training is built around that reality. Rather than walking staff through a generic RSE overview, we focus on the specific moments teachers find hardest: managing disclosures, handling unexpected questions, pitching content age-appropriately, navigating parent concerns, and building the personal confidence to hold the room.',
  'Every session is led by a specialist who has delivered RSE directly to students in hundreds of schools. That matters. The training isn\'t theoretical, it\'s shaped by what actually happens in the classroom, and what actually works.',
  'We don\'t run a catalogue of separate sessions. Every engagement starts from a shared core and is shaped to what your staff are actually being asked to teach, in your school, this year.',
  'We offer half-day, full-day, and multi-session programmes, delivered in person at your school. Programmes are aligned to DfE statutory guidance, KCSIE, and the PSHE Association framework.',
];

// Operational specifics for the meta strip — shown between hero and
// description. Edit values here, not in the markup.
const metaStripItems = [
  { label: 'Formats', value: 'Twilight (3 hours), half-day, full-day, multi-session' },
  { label: 'Delivery', value: 'In person, UK-wide' },
  { label: 'Group size', value: 'Up to 20 per facilitator' },
  { label: 'Pricing', value: 'Twilight from £375; full programmes priced on enquiry' },
  { label: 'Alignment', value: 'DfE statutory guidance, KCSIE, PSHE Association framework' },
];

// Pre-enquiry FAQ — the questions PSHE leads actually ask before they
// fill in the contact form. Each item is mirrored into FAQPage JSON-LD
// below so Google can match it to PAA / featured-snippet queries.
// Drafted in Tailor voice; revise freely.
const faqItems = [
  {
    question: 'How long is RSE staff training?',
    answer:
      'It depends on what you need. A twilight session is three hours and works well for an introduction or a single high-pressure topic. A half-day is the most common booking — enough time to cover the framework, work through scenarios, and answer the questions staff actually have. Full-day or multi-session programmes are for departments going deeper, or schools rolling out a curriculum revision.',
  },
  {
    question: 'Who is the training for?',
    answer:
      'PSHE leads, form tutors, and the wider team being asked to deliver RSE. We work with whole secondary departments, mixed-role groups, and senior leadership separately when the conversation is about strategy rather than delivery. The work is most useful when the people in the room are the ones who\'ll be teaching it.',
  },
  {
    question: 'Do you cover the hard topics — FGM, pornography, consent, masculinity?',
    answer:
      'Yes. These are usually the reason schools call us. We cover them with the same framework we use for the easier topics: what to say when you\'re asked the question, how to pitch it for the year group in front of you, and what to do when the conversation moves somewhere unexpected. Avoiding the hard topics in training doesn\'t make them easier in the classroom.',
  },
  {
    question: 'Is the training appropriate for staff who\'ve never taught RSE before?',
    answer:
      'Yes. A lot of the staff we work with have inherited RSE rather than chosen it. The training is paced for that. We don\'t assume prior subject knowledge and we don\'t make it a problem if someone is starting from scratch.',
  },
  {
    question: 'How is your training different from a generic RSE walkthrough?',
    answer:
      'It\'s led by someone who teaches the same content directly to students, in dozens of schools every term. That means the examples are real, the scripts have been tested in front of Year 9, and the difficult moments come from the classroom rather than the textbook. We focus on what to do when something goes off-plan, because that\'s the part teachers find hardest.',
  },
  {
    question: 'Can the training be tailored to our school, year group, or curriculum?',
    answer:
      'Always. Every engagement starts with a conversation about what your staff are actually being asked to teach, the year groups in scope, and the parts of the curriculum you most want covered. We don\'t run a fixed catalogue. The shared core is the same; how we shape it for your school changes every time.',
  },
  {
    question: 'What do staff leave with?',
    answer:
      'Confidence to teach the topics they were dreading. A shared framework the whole team can use. Concrete scripts for the hardest moments — disclosures, off-topic questions, parent conversations. And a written resource pack staff can return to after the training.',
  },
  {
    question: 'How far in advance do schools usually book?',
    answer:
      'Anything from two weeks to a term ahead. We hold a small number of urgent slots each half-term for schools who need training before a planned delivery; if you\'re trying to get something into the calendar before September, get in touch sooner rather than later.',
  },
];

const whatSchoolsGet =
  'Staff who feel genuinely prepared, not just compliant. A shared vocabulary and framework that the whole RSE team is working from. Concrete scripts for the hardest moments, disclosures, off-topic questions, parent conversations. And a written resource pack staff can return to after the training.';

const featureCards = [
  { title: 'Managing disclosures', description: 'How to respond when a student discloses. What to say in the moment. What to do afterwards. Fully KCSIE-aligned.' },
  { title: 'Handling difficult questions', description: 'The questions students ask that staff most fear. Practical scripts and a framework for any question you haven\'t heard yet.' },
  { title: 'Age-appropriate pitching', description: 'Matching content to year groups, what to include, what to hold back, how to read a room that isn\'t ready.' },
  { title: 'Resource pack', description: 'All attendees receive a written resource pack to reference after the training.' },
];

const [proofTestimonial] = await getTestimonialsByService('RSE training');
const testimonialQuote = proofTestimonial?.quote ?? null;
const testimonialSource = proofTestimonial
  ? [proofTestimonial.name, proofTestimonial.role, proofTestimonial.organisation].filter(Boolean).join(', ')
  : null;

const featuredTopicSlugs = [
  'consent',
  'masculinity-and-misogyny',
  'pornography-and-media-literacy',
  'lgbtq-inclusion',
  'abuse-exploitation-and-violence',
  'sexting-and-sharing-nudes',
];

// --- Content --------------------------------------------------------
const allPosts = await getBlogPosts();
const relatedPosts = allPosts.filter((p) => p.serviceLink === 'training').slice(0, 3);

const metaTitle = `RSE training for school staff, Tailor Education`;
const metaDescription = 'RSE training for school staff, led by a specialist who has delivered it in hundreds of schools. Half-day, full-day, or bespoke programmes, in person.';
const canonicalPath = `/services/${slug}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    serviceJsonLd({
      name: 'RSE training for school staff',
      description: metaDescription,
      canonicalPath,
      serviceType: 'Teacher training',
      audienceRoles: ['School leader', 'PSHE lead', 'Teacher'],
      offer: { priceText: 'Twilight from £375; full programmes priced on enquiry' },
    }),
    faqJsonLd(faqItems),
    breadcrumbJsonLd([
      { name: 'Services', path: '/services/' },
      { name: 'RSE training', path: canonicalPath },
    ]),
  ],
};
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonicalPath={canonicalPath}
  ogImage={heroImage ?? undefined}
  ogImageWidth={heroImageWidth}
  ogImageHeight={heroImageHeight}
  jsonLd={jsonLd}
  {...(heroImage ? heroPreload(heroImage) : {})}
>
  <article class="service-page" data-pagefind-body>

    <header class="service-hero">
      <div class="service-hero__inner">
        <div class="service-hero__text">
            <span class="service-hero__eyebrow">Services</span>
            <h1 class="service-hero__title">{pageHeading}</h1>
            <p class="service-hero__subtitle">{heroSubtitle}</p>
            <a
              href={`/contact?service=${encodeURIComponent(serviceParam)}`}
              class="btn btn--std btn--primary has-icon-hover w-full sm:w-auto"
              data-analytics-event="cta_click"
              data-analytics-cta-type="hero_enquire"
              data-analytics-service-type={serviceParam}
            >Arrange staff training</a>
          </div>
          <div class="service-hero__image">
            {heroImage ? (
              <HeroImage src={heroImage} alt={heroImageAlt} width={heroImageWidth} height={heroImageHeight} priority />
            ) : (
              <div class="service-hero__image-placeholder">Hero photography required, source before launch</div>
            )}
          </div>
        </div>
    </header>

    <ServiceMetaStrip items={metaStripItems} ariaLabel="RSE training at a glance" />

    <aside class="service-callout" aria-label="September 2026 statutory revision">
      <div class="mx-auto w-full max-w-[var(--container-max-prose)] px-[var(--space-global-gutter)] py-[var(--space-global-lg)]">
        <p class="service-callout__eyebrow">September 2026</p>
        <p class="service-callout__body">
          The DfE's revised RSE statutory guidance becomes mandatory from
          September 2026. Most schools booking training this year are doing
          it to land a curriculum revision before the deadline, especially
          the new content on online safety, AI literacy, and misogyny.
          {' '}<a href="/blog/2026-rse-guidance-plain-english-summary/">Plain-English summary of what's changed →</a>
        </p>
      </div>
    </aside>

    <section class="service-description">
      <div class="mx-auto w-full max-w-[var(--container-max-prose)] px-[var(--space-global-gutter)] py-[var(--space-struct-y-base)]">
        <h2 class="service-section-title">{descriptionHeading}</h2>
        <p class="service-description__lead">{descriptionLead}</p>
        {descriptionBody.map((para) => (<p>{para}</p>))}
        {whatSchoolsGet && (
          <>
            <h2 class="service-description__sub-title">What schools get</h2>
            <p>{whatSchoolsGet}</p>
          </>
        )}
      </div>
    </section>

    <section class="service-features">
      <div class="mx-auto w-full max-w-[var(--container-max-shell)] px-[var(--space-global-gutter)] py-[var(--space-struct-y-base)]">
        <h2 class="service-section-title">What's included</h2>
        <div class="service-features__grid">
          {featureCards.map((card) => (
            <div class="feature-card">
              <h3 class="feature-card__title">{card.title}</h3>
              <p class="feature-card__text">{card.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="service-proof-band">
      <div class="mx-auto w-full max-w-[var(--container-max-prose)] px-[var(--space-global-gutter)] py-[var(--space-struct-y-base)]">
        <div class="service-proof-band__inner">
          {testimonialQuote && (
            <>
              <blockquote>
                <p class="service-proof-band__quote">"{testimonialQuote}"</p>
              </blockquote>
              <span class="service-proof-band__source">{testimonialSource}</span>
            </>
          )}
          <div class="service-proof-band__cta-wrap">
            <a
              href={`/contact?service=${encodeURIComponent(serviceParam)}`}
              class="btn btn--std btn--white-primary has-icon-hover w-full sm:w-auto"
              data-analytics-event="cta_click"
              data-analytics-cta-type="proof_band_enquire"
              data-analytics-service-type={serviceParam}
            >Equip your team</a>
            <a href="/testimonials" class="link-action link-action--muted link-action--card">Read more testimonials</a>
          </div>
        </div>
      </div>
    </section>

    <ServiceFaq items={faqItems} heading="Questions schools ask before booking" />

    {relatedPosts.length > 0 && (
      <section class="service-blog">
        <div class="mx-auto w-full max-w-[var(--container-max-shell)] px-[var(--space-global-gutter)] py-[var(--space-struct-y-base)]">
          <h2 class="service-section-title">Related articles</h2>
          <div class="service-blog__grid">
            {relatedPosts.map((bp) => (
              <a href={`/blog/${bp.slug}`} class="card card--lift service-blog-card">
                {bp.featuredImage && (
                  <div class="service-blog-card__img">
                    <img src={bp.featuredImage} alt="" loading="lazy" />
                  </div>
                )}
                <div class="card__body">
                  {bp.targetAudience && <div class="card__eyebrow">{bp.targetAudience}</div>}
                  <h3 class="card__title">{bp.title}</h3>
                  {bp.author && <div class="service-blog-card__author">By {bp.author}</div>}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <ServiceTopicsStrip featuredSlugs={featuredTopicSlugs} />

    <CtaServiceEnquiry serviceName={serviceName} serviceParam={serviceParam} variant="alt" />

  </article>
</BaseLayout>
