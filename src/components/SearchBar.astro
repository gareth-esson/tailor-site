---
/**
 * Site search bar [A4] with instant results dropdown [A5].
 * Uses Pagefind for client-side search.
 * Desktop: visible text input in header.
 * Mobile: icon toggle that expands to input.
 *
 * Behaviour lives in src/scripts/search-header.ts — a bundled module, not an
 * inline script, so it shares the search taxonomy (src/lib/searchTypes.ts)
 * and the tested search helpers (src/lib/search-client.ts) with the B10
 * search page instead of duplicating them.
 */
---

<div class="search-bar" id="search-bar">
  <!-- Mobile toggle -->
  <button
    class="search-bar__toggle"
    type="button"
    aria-label="Open search"
    aria-expanded="false"
    aria-controls="search-bar-input"
  >
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="5.75" stroke="currentColor" stroke-width="1.5"/>
      <path d="M13 13L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </button>

  <!-- Search input -->
  <div class="search-bar__input-wrap" id="search-bar-input-wrap">
    <svg class="search-bar__icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="5.75" stroke="currentColor" stroke-width="1.5"/>
      <path d="M13 13L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <input
      class="search-bar__input"
      type="search"
      id="search-bar-input"
      placeholder="Search services, training and articles"
      autocomplete="off"
      aria-label="Search the site"
    />
    <button class="search-bar__close" type="button" aria-label="Close search">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 4L12 12M12 4L4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Instant results dropdown [A5] -->
  <div class="search-bar__dropdown" id="search-dropdown" aria-live="polite" hidden>
    <div class="search-bar__results" id="search-results"></div>
    <a class="search-bar__see-all" id="search-see-all" href="/search">
      See all results &rarr;
    </a>
  </div>
</div>

<script>
  import { initSearchHeader } from '../scripts/search-header';
  initSearchHeader();
  document.addEventListener('astro:after-swap', initSearchHeader);
</script>

<style>
  .search-bar {
    min-width: 0;
    position: relative;
    display: flex;
    align-items: center;
  }

  /* Mobile toggle button — hidden; inline input is always visible now */
  .search-bar__toggle {
    display: none;
  }

  /* Input wrapper — visible at all breakpoints */
  .search-bar__input-wrap {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-global-xs);
    background: var(--bg-surface-alt);
    border: var(--border-width-xs) solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.375rem 0.75rem;
    width: clamp(8rem, 38vw, 14rem);
    transition: border-color var(--transition-duration) var(--transition-easing);
  }

  .search-bar__input-wrap:focus-within {
    border-color: var(--brand-accent);
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  /* Mobile expanded state */
  .search-bar__input-wrap.is-expanded {
    display: flex;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 16rem;
    z-index: var(--z-dropdown);
    background: var(--bg-surface);
    box-shadow: var(--shadow-md);
  }

  .search-bar__icon {
    flex-shrink: 0;
    color: var(--text-body-muted);
  }

  .search-bar__input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-family: var(--font-shell-body-stack);
    font-size: var(--text-card-size-body);
    color: var(--text-body);
    outline: none;
    padding: 0;
  }

  .search-bar__input::placeholder {
    color: var(--form-placeholder-color);
  }

  .search-bar__close {
    display: none;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    color: var(--text-body-muted);
    cursor: pointer;
    padding: 0;
  }

  /* Dropdown [A5] */
  .search-bar__dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: 22rem;
    max-height: 28rem;
    overflow-y: auto;
    background: var(--bg-surface);
    border: var(--border-width-xs) solid var(--border-subtle);
    border-radius: var(--radius-base);
    box-shadow: var(--shadow-lg);
    z-index: var(--z-dropdown);
    padding: var(--space-global-xs);
  }

  @media (max-width: 1023px) {
    .search-bar__dropdown {
      /* Leave room for both gutters and the adjacent 44px mobile menu button. */
      max-width: calc(100vw - 2 * var(--space-global-gutter) - 2.75rem - var(--space-global-sm));
    }
  }

  /* Results are created in JavaScript, so only the static container is scoped. */
  .search-bar :global(.search-bar__group) {
    margin-bottom: var(--space-global-xs);
  }

  .search-bar :global(.search-bar__group:last-child) {
    margin-bottom: 0;
  }

  .search-bar :global(.search-bar__group-label) {
    font-family: var(--font-shell-body-stack);
    font-size: var(--text-util-micro-size);
    font-weight: var(--font-weight-semibold);
    color: var(--text-body-muted);
    text-transform: uppercase;
    letter-spacing: var(--badge-letter-spacing);
    padding: 0.25rem 0.5rem;
  }

  .search-bar :global(.search-bar__result) {
    display: block;
    padding: 0.5rem;
    border-radius: var(--radius-xs);
    text-decoration: none;
    color: var(--text-body);
    transition: background var(--transition-duration) var(--transition-easing);
  }

  .search-bar :global(.search-bar__result:hover) {
    background: var(--bg-surface-alt);
  }

  .search-bar :global(.search-bar__result-title) {
    display: block;
    font-family: var(--font-shell-body-stack);
    font-size: var(--text-card-size-body);
    font-weight: var(--font-weight-medium);
    color: var(--text-heading);
  }

  .search-bar :global(.search-bar__result-excerpt) {
    display: block;
    font-size: var(--text-util-micro-size);
    color: var(--text-body-muted);
    margin-top: 0.125rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .search-bar :global(.search-bar__result-excerpt mark) {
    background: var(--brand-accent-soft);
    color: var(--text-body);
    border-radius: var(--radius-xs);
    padding: 0 1px;
  }

  .search-bar :global(.search-bar__empty) {
    padding: 1rem 0.5rem;
    font-family: var(--font-shell-body-stack);
    font-size: var(--text-card-size-body);
    color: var(--text-body-muted);
    text-align: center;
  }

  .search-bar__see-all {
    display: block;
    padding: 0.5rem;
    text-align: center;
    font-family: var(--font-shell-body-stack);
    font-size: var(--text-card-size-body);
    font-weight: var(--font-weight-medium);
    color: var(--link-action-color);
    text-decoration: none;
    border-top: var(--border-width-xs) solid var(--border-subtle);
    margin-top: var(--space-global-xs);
    padding-top: var(--space-global-xs);
  }

  .search-bar__see-all:hover {
    color: var(--link-action-color-hover);
  }
</style>
