---
/**
 * Stages in Relationships — participant screen for a live session.
 * /tools/stages-in-relationships/join/?code=ABC123
 *
 * Built for a phone, so it uses ScreenLayout rather than BaseLayout: no
 * site header, footer or cookie banner taking up the screen. A slim bar
 * on top, the activity below.
 * Logic: src/scripts/stages/join.ts
 */
import ScreenLayout from '../../../layouts/ScreenLayout.astro';
import StagesThemeInit from '../../../components/StagesThemeInit.astro';
import StagesThemeToggle from '../../../components/StagesThemeToggle.astro';
import '../../../styles/stages-tool.css';
---

<ScreenLayout title="Stages in Relationships: join">
  <div class="stages-page stages-phone" id="stages-join">
    <StagesThemeInit />
    <header class="stages-phone__bar">
      <h1 class="stages-phone__title">Stages in Relationships</h1>
      <StagesThemeToggle />
    </header>
    <main class="stages-phone__main stages-stack" id="stages-join-main">
      <noscript>
        <p class="stages-note">Joining a session needs JavaScript.</p>
      </noscript>
    </main>
  </div>
</ScreenLayout>

<script>
  import { initJoinPage } from '../../../scripts/stages/join';
  initJoinPage();
</script>
