---
/**
 * Printable RSE policy audit sheet.
 *
 * The page IS the artefact: two A4 sides that print with no site chrome.
 * Everything above the first sheet is screen-only. Ungated — no form, no
 * email capture; the service page does the converting.
 *
 * Styling consumes tailor-site-v2.css (.table--compact, .surface--alt,
 * .badge--solid-accent, .microtext, card type scale). Millimetres are used
 * for physical page geometry only.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'RSE policy audit sheet';
const description =
  'A free printable two-page audit sheet for checking your RSE policy, curriculum plan and teaching against the RSHE statutory guidance in force since September 2026.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/resources/rse-policy-audit-sheet/"
>
  <div class="sheet-intro">
    <div class="sheet-intro__inner">
      <h1 class="sheet-intro__title">RSE policy audit sheet</h1>
      <p class="sheet-intro__lede lede">
        Two sides of A4 for checking your policy, curriculum plan and teaching
        against the RSHE statutory guidance that has applied in England since
        1 September 2026. Free to print and use — no sign-up, no email address.
      </p>
      <p class="sheet-intro__note">
        Keep the completed sheet. It is evidence of the monitoring your policy
        is asked to describe. The reasoning behind each check is in
        <a class="link-inline" href="/blog/rse-policy-checklist-2026/">the full checklist post</a>.
      </p>
      <button type="button" class="btn btn--std btn--tint" data-print-sheet>
        Print the sheet
      </button>
    </div>
  </div>

  <section class="sheet">
  
    <div class="sheet__top">
      <div>
        <h2 class="sheet__title">RSE policy audit sheet</h2>
        <p class="sheet__standfirst">Check your policy, curriculum plan and teaching against the RSHE statutory guidance
          that has applied in England since 1 September 2026. Work through it with the policy open and one term's
          planning beside it, and answer each line with a document rather than a recollection.</p>
      </div>
      <div class="sheet__brand">
        <img class="sheet__logo" src="/assets/tailor-logo-lockup-dark.svg" alt="Tailor" />
        <div class="sheet__url">tailor-rse.org.uk</div>
      </div>
    </div>
  
    <div class="fields">
      <div class="field"><span class="field__label">School</span><div class="field__rule"></div></div>
      <div class="field"><span class="field__label">Completed by</span><div class="field__rule"></div></div>
      <div class="field"><span class="field__label">Date</span><div class="field__rule"></div></div>
      <div class="field"><span class="field__label">Next review</span><div class="field__rule"></div></div>
    </div>
  
    <div class="primer surface surface--alt">
      <h2 class="primer__title">If you only do four things</h2>
      <ol>
        <li><strong>Read your provider contracts.</strong> Clauses stopping you showing parents material are void (57–58).</li>
        <li><strong>Make the policy match a timetable.</strong> Content, timing and who teaches it (14).</li>
        <li><strong>Check sequencing, not just coverage.</strong> Sensitive content has to land before pupils meet it (15d).</li>
        <li><strong>Train before you teach suicide prevention.</strong> The training is a precondition, not a follow-up (44).</li>
      </ol>
    </div>
  
    <div class="section">
      <h2 class="section__heading">1 &nbsp;The policy document</h2>
      <table class="table table--compact">
        <colgroup><col class="c-check"><col class="c-ref"><col class="c-box"><col class="c-box"><col class="c-notes"></colgroup>
        <thead><tr>
          <th>Check</th><th>Ref</th><th class="is-centred">In&nbsp;place</th><th class="is-centred">Action</th><th>Evidence / notes</th>
        </tr></thead>
        <tbody>
          <tr>
            <td>An up-to-date written policy exists for relationships education, or for RSE where sex education is taught<span class="badge badge--solid-accent">must</span></td>
            <td class="check__ref">12</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>It is published on the school website, and a free copy goes to anyone who asks<span class="badge badge--solid-accent">must</span></td>
            <td class="check__ref">12</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>The published version is the version staff actually teach from</td>
            <td class="check__ref">&mdash;</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>It contains all eight things paragraph 14 asks for
              <span class="check__detail">Content, timing and staffing · the relationships / sex education split · the right to withdraw · SEND accessibility · monitoring · how parents view materials · unanswered questions · approval and review</span></td>
            <td class="check__ref">14</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
        </tbody>
      </table>
    </div>
  
    <div class="section">
      <h2 class="section__heading">2 &nbsp;Parents</h2>
      <table class="table table--compact">
        <colgroup><col class="c-check"><col class="c-ref"><col class="c-box"><col class="c-box"><col class="c-notes"></colgroup>
        <thead><tr>
          <th>Check</th><th>Ref</th><th class="is-centred">In&nbsp;place</th><th class="is-centred">Action</th><th>Evidence / notes</th>
        </tr></thead>
        <tbody>
          <tr>
            <td>Parents were consulted on the policy, with a dated record of what they raised and what changed<span class="badge badge--solid-accent">must</span></td>
            <td class="check__ref">12</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>A parent asking today could be shown a representative sample of resources, and all materials on request</td>
            <td class="check__ref">56</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>Every external provider contract has been read for clauses restricting what you may show parents
              <span class="check__detail">Clauses preventing a school sharing any material at all with parents are void and unenforceable</span></td>
            <td class="check__ref">57–58</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td><em>Primary:</em> parents were consulted on sex education content specifically, and offered help talking to their children about it</td>
            <td class="check__ref">31</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>Withdrawal is handled as the guidance describes
              <span class="check__detail">Discussion with parents recorded · purposeful work for withdrawn pupils · pupils know they can opt back in from three terms before 16 · primary must be granted, secondary refused only in exceptional circumstances</span></td>
            <td class="check__ref">17–20</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
        </tbody>
      </table>
    </div>
  
    <div class="section">
      <h2 class="section__heading">Other findings</h2>
      <div class="openspace__rules"><span></span><span></span><span></span></div>
    </div>
  
    <div class="sheet__spacer"></div>
  
    <div class="sheet__foot">
      <p class="microtext">Paragraph numbers refer to <em>Relationships Education, Relationships and Sex Education (RSE) and Health
        Education</em>, Department for Education, July 2025.<span class="pagenum">Side 1 of 2</span></p>
    </div>
  
  </section>
  
  <section class="sheet">
  
    <div class="sheet__top">
      <div>
        <h2 class="sheet__title">RSE policy audit sheet <span>&mdash; continued</span></h2>
        <p class="sheet__standfirst">Sides one and two make one record.</p>
      </div>
      <div class="sheet__brand">
        <img class="sheet__logo" src="/assets/tailor-logo-lockup-dark.svg" alt="Tailor" />
        <div class="sheet__url">tailor-rse.org.uk</div>
      </div>
    </div>
  
    <div class="section">
      <h2 class="section__heading">3 &nbsp;The curriculum</h2>
      <table class="table table--compact">
        <colgroup><col class="c-check"><col class="c-ref"><col class="c-box"><col class="c-box"><col class="c-notes"></colgroup>
        <thead><tr>
          <th>Check</th><th>Ref</th><th class="is-centred">In&nbsp;place</th><th class="is-centred">Action</th><th>Evidence / notes</th>
        </tr></thead>
        <tbody>
          <tr>
            <td>A coverage map runs the guidance's content tables against your scheme of work, showing where each item is taught and by whom
              <span class="check__detail">If you build one thing this year, build this</span></td>
            <td class="check__ref">&mdash;</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>The map shows <em>when</em> each item is taught, and sensitive content lands before pupils are likely to meet it
              <span class="check__detail">The guidance notes periods can start at eight, against an average onset of twelve</span></td>
            <td class="check__ref">15d, 40</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>RSHE has been checked against science, citizenship, computing and PE so the subjects complement rather than duplicate</td>
            <td class="check__ref">51</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>Newer content is present: deepfakes · sextortion · strangulation and suffocation as criminal offences ·
              incels and online influencers · gambling-like content in gaming · vaping named separately · fertility,
              menopause, miscarriage and pregnancy loss</td>
            <td class="check__ref">&mdash;</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>Pupils get chances to practise skills, not only acquire knowledge
              <span class="check__detail">Assertiveness, expressing needs and boundaries, respectful communication</span></td>
            <td class="check__ref">50</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>There is some evidence of what pupils took away from a unit</td>
            <td class="check__ref">50</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
        </tbody>
      </table>
    </div>
  
    <div class="section">
      <h2 class="section__heading">4 &nbsp;The people teaching it</h2>
      <table class="table table--compact">
        <colgroup><col class="c-check"><col class="c-ref"><col class="c-box"><col class="c-box"><col class="c-notes"></colgroup>
        <thead><tr>
          <th>Check</th><th>Ref</th><th class="is-centred">In&nbsp;place</th><th class="is-centred">Action</th><th>Evidence / notes</th>
        </tr></thead>
        <tbody>
          <tr>
            <td>Staff teaching RSHE this year have had training matching what they teach, including safeguarding, given the increased possibility of disclosures</td>
            <td class="check__ref">15f</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>Anyone teaching suicide prevention, self-harm or eating disorders has the specific preparation the guidance asks for
              <span class="check__detail">Mental health professionals consulted and evidence-based staff training in place <em>before</em> the topic is taught directly</span></td>
            <td class="check__ref">42–46</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>For every visitor booked this year: credentials checked, lesson plan seen in advance, and the handling of a disclosure agreed in writing beforehand<span class="badge badge--solid-accent">must</span></td>
            <td class="check__ref">52, 84</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>Teachers know what to say to a question the scheme does not cover, and it matches what the policy claims they will say</td>
            <td class="check__ref">87</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
        </tbody>
      </table>
    </div>
  
    <div class="section">
      <h2 class="section__heading">5 &nbsp;Equality and governance</h2>
      <table class="table table--compact">
        <colgroup><col class="c-check"><col class="c-ref"><col class="c-box"><col class="c-box"><col class="c-notes"></colgroup>
        <thead><tr>
          <th>Check</th><th>Ref</th><th class="is-centred">In&nbsp;place</th><th class="is-centred">Action</th><th>Evidence / notes</th>
        </tr></thead>
        <tbody>
          <tr>
            <td>Teaching complies with the Equality Act 2010 and does not discriminate or amount to harassment
              <span class="check__detail">The public sector equality duty applies to most schools; independent schools that are not academies are not subject to it</span></td>
            <td class="check__ref">64–65</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>Staff teaching the content on sexual orientation, biological sex and gender reassignment have read paragraphs 67 to 72 rather than a summary of them</td>
            <td class="check__ref">67–72</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
          <tr>
            <td>Governors or trustees can answer the four things asked of them
              <span class="check__detail">Pupil progress · accessibility for pupils with SEND · content and materials aligned with the guidance · clear information for parents</span></td>
            <td class="check__ref">61</td><td class="is-centred"><span class="tick"></span></td><td class="is-centred"><span class="tick"></span></td><td></td>
          </tr>
        </tbody>
      </table>
    </div>
  
    <div class="sheet__spacer"></div>
  
    <div class="sheet__foot">
      <div class="signoff">
        <div class="field"><span class="field__label">Reviewed with / reported to</span><div class="field__rule"></div></div>
        <div class="field"><span class="field__label">Signed</span><div class="field__rule"></div></div>
      </div>
      <p class="microtext">Paragraph numbers refer to <em>Relationships Education, Relationships and Sex Education (RSE) and Health
        Education</em>, Department for Education, July 2025, at
        <a href="https://www.gov.uk/government/publications/relationships-education-relationships-and-sex-education-rse-and-health-education">gov.uk</a>.
        Read alongside <em>Keeping children safe in education</em>.</p>
      <p class="microtext">A completed sheet records what you found on a particular date against the paragraphs named here. It is not
        legal certification, and a specific situation may need your own legal advice.<span class="pagenum">Side 2 of 2</span></p>
    </div>
  
  </section>
</BaseLayout>

<script>
  document
    .querySelector('[data-print-sheet]')
    ?.addEventListener('click', () => window.print());
</script>

<style is:global>

/* =====================================================================
   RSE policy audit sheet — printable resource
   Every colour, type size, radius and border comes from
   tailor-site-v2.css. Components used: .table / .table--compact,
   .surface / .surface--alt, .badge / .badge--solid-accent, .microtext.

   Millimetres are used for PHYSICAL PAGE GEOMETRY only (page box,
   column widths, tick-box size, rule spacing). This is a printed
   artefact, so those are real-world measurements rather than design
   values — the same carve-out the rules make for px inside @media.
   ===================================================================== */

/* Print density. The system's table and utility scales are tuned for
   screen reading; an A4 form needs to fit 20 ruled rows on two sides.
   Retune the component's own tokens rather than hardcoding padding and
   font sizes, so the sheet still tracks the system if those change. */
.sheet{
  --table-font-size:11.5px;
  --table-header-size:11px;
  --table-cell-padding-y:0.3rem;
  --table-compact-padding-y:0.11rem;
  --table-compact-padding-x:var(--space-global-xs);
}

/* ── the sheet ───────────────────────────────────────────────────── */
.sheet{
  width:210mm;
  min-height:297mm;
  padding:11mm 12mm 8mm;
  margin:var(--space-global-md) auto;
  background:var(--bg-page);
  box-shadow:var(--shadow-md);
  display:flex;
  flex-direction:column;
}

/* ── masthead ────────────────────────────────────────────────────── */
.sheet__top{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:var(--space-global-lg);
  border-bottom:var(--border-width-sm) solid var(--brand-accent);
  padding-bottom:var(--space-global-sm);
}
.sheet__title{
  font-size:var(--text-card-size-h2);
  line-height:var(--lh-heading);
  color:var(--text-heading);
  margin:0 0 var(--space-global-xs);
}
.sheet__title span{
  font-weight:400;
  color:var(--text-body-muted);
}
.sheet__standfirst{
  margin:0;
  font-size:var(--text-card-size-h6);
  line-height:var(--lh-card);
  color:var(--text-body-muted);
  max-width:118mm;
}
.sheet__brand{text-align:right;flex-shrink:0;}
.sheet__logo{display:block;width:36mm;height:auto;margin-left:auto;}
.sheet__url{
  font-size:var(--text-card-size-h6);
  color:var(--text-body-muted);
  margin-top:var(--space-global-xs);
}

/* ── fill-in fields ──────────────────────────────────────────────── */
.fields{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:var(--space-global-md);
  margin-top:var(--space-global-sm);
}
.field__label{
  display:block;
  font-size:var(--text-card-size-h6);
  font-weight:var(--table-header-weight);
  letter-spacing:var(--table-header-tracking);
  text-transform:uppercase;
  color:var(--brand-accent-text);
  margin-bottom:var(--space-global-sm);
}
.field__rule{border-bottom:var(--border-width-xs) solid var(--border-strong);}

/* ── priority panel (.surface--alt, tokens tuned for print density) ─
   No single-side accent border: a thick border on one edge of a rounded
   box tapers to nothing at both corners. The tinted surface separates the
   panel and the teal title carries the accent. */
.primer{
  --surface-padding:var(--space-global-sm);
  --surface-radius:var(--radius-base);
  margin-top:var(--space-global-sm);
}
.primer__title{
  font-size:var(--text-card-size-h6);
  font-weight:var(--table-header-weight);
  letter-spacing:var(--table-header-tracking);
  text-transform:uppercase;
  color:var(--brand-accent-text);
  margin:0 0 var(--space-global-xs);
}
.primer ol{
  margin:0;
  list-style:decimal;
  padding-left:var(--space-global-md);
  columns:2;
  column-gap:var(--space-global-lg);
  font-size:var(--text-card-size-h6);
  line-height:var(--lh-card);
  color:var(--text-body);
}
.primer li{margin-bottom:var(--space-global-xs);break-inside:avoid;}
.primer strong{font-weight:var(--font-weight-semibold);}

/* ── checklist sections ──────────────────────────────────────────── */
.section{margin-top:0.25rem;}
.section__heading{
  font-size:var(--text-card-size-h6);
  font-weight:var(--table-header-weight);
  letter-spacing:var(--table-header-tracking);
  text-transform:uppercase;
  color:var(--brand-accent-text);
  margin:0 0 var(--space-global-xs);
  padding-bottom:var(--space-global-xs);
  border-bottom:var(--border-width-xs) solid var(--brand-accent);
}

/* Physical column geometry for the printed grid. */
table{table-layout:fixed;}
col.c-check{width:auto;}
col.c-ref{width:13mm;}
col.c-box{width:18mm;}
col.c-notes{width:39mm;}

/* The component clears the last row's rule; a fill-in sheet wants every
   row ruled so there is a line to write on. */
.table tbody tr:last-child td{
  border-bottom:var(--border-width-xs) solid var(--table-border-color);
  padding-bottom:var(--table-compact-padding-y);
}
.table thead th.is-centred,
.table tbody td.is-centred{text-align:center;}

.check__detail{
  display:block;
  color:var(--text-body-muted);
  font-size:0.92em;
  line-height:1.26;
  margin-top:0.15em;
}
.check__ref{
  color:var(--text-body-muted);
  font-variant-numeric:tabular-nums;
  white-space:nowrap;
}
.tick{
  display:inline-block;
  width:4.2mm;
  height:4.2mm;
  border:var(--border-width-xs) solid var(--border-strong);
  border-radius:var(--radius-xs);
}
.badge{vertical-align:1px;margin-left:var(--space-global-xs);}

/* ── open writing space ──────────────────────────────────────────── */
.openspace__rules{
  display:flex;
  flex-direction:column;
  gap:5.5mm;
  padding-top:3.5mm;
}
.openspace__rules span{border-bottom:var(--border-width-xs) solid var(--table-border-color);}

/* ── foot ────────────────────────────────────────────────────────── */
.sheet__spacer{flex:1;}
.sheet__foot{
  margin-top:var(--space-global-xs);
  padding-top:var(--space-global-xs);
  border-top:var(--border-width-xs) solid var(--border-subtle);
  color:var(--text-body-muted);
}
.sheet__foot p{margin:0 0 var(--space-global-xs);}
.signoff{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:var(--space-global-lg);
  margin-bottom:0;
}
.sheet__foot .field__label{margin-bottom:var(--space-global-xs);}
.pagenum{float:right;font-weight:var(--font-weight-semibold);}

/* ── screen-only intro ───────────────────────────────────────────── */
.sheet-intro{
  padding:var(--space-global-xl) var(--space-global-gutter) var(--space-global-lg);
}
.sheet-intro__inner{
  max-width:var(--container-max-hero-text);
  margin-inline:auto;
}
.sheet-intro__title{
  font-size:var(--text-prose-size-h1);
  line-height:var(--lh-heading);
  margin:0 0 var(--space-global-sm);
}
.sheet-intro__lede{
  margin:0 0 var(--space-global-sm);
  color:var(--text-body-muted);
}
.sheet-intro__note{
  margin:0 0 var(--space-global-md);
  color:var(--text-body-muted);
}

/* On screen the sheets sit on the page ground like sheets of paper. */
.sheet{
  box-shadow:var(--shadow-md);
  margin-inline:auto;
}

/* ── print ───────────────────────────────────────────────────────── */
@page{size:A4 portrait;margin:0;}
@media print{
  .site-header,
  .site-footer,
  .cookie-banner,
  .sheet-intro{display:none;}
  .sheet{
    margin:0;
    box-shadow:none;
    width:auto;
    min-height:auto;
    /* No fixed height: if content ever outgrows the page it spills to a
       visible extra sheet instead of silently clipping the last row. */
    page-break-after:always;
  }
  .sheet:last-of-type{page-break-after:auto;}
}
</style>
