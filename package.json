{
  "name": "tailor-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build:index",
    "build:index": "npx pagefind --site .vercel/output/static --output-path .vercel/output/static/pagefind && npm run build:search-titles",
    "build:search-titles": "node scripts/build-search-titles.mjs",
    "preview": "astro preview",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^10.0.4",
    "@fontsource/lexend": "^5.2.11",
    "@notionhq/client": "^5.16.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.3",
    "notion-to-md": "^3.1.9",
    "pagefind": "^1.4.0",
    "postgres": "^3.4.9",
    "probe-image-size": "^7.3.0",
    "redis": "^5.12.1",
    "sortablejs": "^1.15.6",
    "tailwindcss": "^4.2.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0"
  },
  "devDependencies": {
    "@types/sortablejs": "^1.15.9"
  }
}
