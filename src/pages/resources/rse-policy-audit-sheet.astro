---
/**
 * RSE policy audit sheet — the public, indexable resource page.
 *
 * The page used to *be* the artefact: two A4 sides rendered inline with a
 * button calling window.print(). That handed the output to the reader's
 * print dialog, which supplies its own margins, its own headers and
 * footers and a "fit to page" scale — so the sheet printed badly and
 * there was nothing we could do about it from here.
 *
 * Now the sheet is a real PDF, generated from /render/rse-policy-audit-sheet/
 * by `npm run pdf:audit-sheet` and committed to public/downloads/. This page
 * describes it and links to it. The sheet's markup lives only in the render
 * route — one copy, so the page and the file cannot drift apart.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'RSE policy audit sheet';
const description =
  'A free two-page audit sheet for checking your RSE policy, curriculum plan and teaching against the RSHE statutory guidance in force since September 2026.';

const pdfPath = '/downloads/rse-policy-audit-sheet.pdf';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/resources/rse-policy-audit-sheet/"
>
  <div class="sheet-intro" data-pagefind-body>
    <div class="sheet-intro__inner">
      <span class="preheader">Free resource</span>
      <h1 class="sheet-intro__title">RSE policy audit sheet</h1>
      <p class="sheet-intro__lede lede">
        Two sides of A4 for checking your policy, curriculum plan and teaching
        against the RSHE statutory guidance that has applied in England since
        1 September 2026. Work through it with the policy open and one term's
        planning beside it, and answer each line with a document rather than a
        recollection.
      </p>

      <ul class="sheet-intro__facts">
        <li><span class="sheet-intro__facts-label">Format</span> PDF, two sides of A4</li>
        <li><span class="sheet-intro__facts-label">Covers</span> Policy · parents · curriculum · staffing · governance</li>
        <li><span class="sheet-intro__facts-label">Source</span> DfE guidance, July 2025</li>
      </ul>

      <p class="sheet-intro__note">
        A completed sheet is evidence of the monitoring your policy is asked to
        describe. The reasoning behind each check is in
        <a class="link-inline" href="/blog/rse-policy-checklist-2026/">the full checklist post</a>.
      </p>

      <a class="btn btn--std btn--primary" href={pdfPath} download>
        Download the sheet
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .sheet-intro {
    padding: var(--space-global-xl) var(--space-global-gutter) var(--space-struct-y-base);
  }

  .sheet-intro__inner {
    max-width: var(--container-max-hero-text);
    margin-inline: auto;
  }

  .sheet-intro__title {
    font-size: var(--text-prose-size-h1);
    line-height: var(--lh-heading);
    margin: 0 0 var(--space-global-sm);
  }

  .sheet-intro__lede {
    margin: 0 0 var(--space-global-lg);
    color: var(--text-body-muted);
  }

  /* Operational facts a PSHE lead scans before deciding to download —
     the same understated label/value treatment as ServiceMetaStrip. */
  .sheet-intro__facts {
    list-style: none;
    margin: 0 0 var(--space-global-lg);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-global-xs);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: var(--space-global-md);
  }

  .sheet-intro__facts li {
    margin: 0;
    color: var(--text-body-muted);
  }

  .sheet-intro__facts-label {
    display: inline-block;
    min-width: 6rem;
    color: var(--text-heading);
  }

  .sheet-intro__note {
    margin: 0 0 var(--space-global-lg);
    color: var(--text-body-muted);
  }

  @media (max-width: 480px) { /* --bp-sm */
    .sheet-intro__facts-label {
      display: block;
      min-width: 0;
    }
  }
</style>
