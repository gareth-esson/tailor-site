---
/**
 * CTA block [A13] — "Enquire about [service]"
 * Used on service pages [C5] and blog posts [C4].
 * Links to /contact with service type pre-selected.
 */
interface Props {
  /** The service name to display */
  serviceName: string;
  /** URL parameter value for pre-filling the enquiry form */
  serviceParam: string;
  /** Visual variant: 'tinted' for mid-page, 'alt' for bottom */
  variant?: 'tinted' | 'alt';
}

const { serviceName, serviceParam, variant = 'tinted' } = Astro.props;
const enquiryUrl = `/contact?service=${encodeURIComponent(serviceParam)}`;
---

<section class:list={['cta-enquiry', variant === 'alt' && 'cta-enquiry--alt']}>
  <div class="mx-auto max-w-[var(--container-max-shell)] px-[var(--space-global-gutter)] py-[var(--space-struct-y-base)]">
    <div class="cta-enquiry__card">
      <div class="cta-enquiry__content">
        <h2 class="cta-enquiry__title">Enquire about {serviceName}</h2>
        <p class="cta-enquiry__text">
          Get in touch to discuss how we can support your school.
        </p>
      </div>
      <div class="cta-enquiry__actions">
        <a
          href={enquiryUrl}
          class="btn btn--std btn--primary has-icon-hover w-full sm:w-auto"
          data-analytics-event="cta_click"
          data-analytics-cta-type="enquire_service"
          data-analytics-service-type={serviceParam}
          data-analytics-target={enquiryUrl}
        >
          Get in touch
        </a>
        {/* Secondary nudge for buyers who aren't ready to enquire —
            keeps them on-site and links to the methodological page that
            explains frameworks, safeguarding, and editorial review.
            Adds internal-link equity to /our-approach from every
            service page. */}
        <a
          href="/our-approach"
          class="link-action link-action--muted cta-enquiry__secondary"
          data-analytics-event="link_click"
          data-analytics-link-type="service_to_approach"
          data-analytics-service-type={serviceParam}
        >
          Or read about our approach to RSE
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-enquiry__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-global-md);
    padding: var(--space-global-lg);
    background: var(--bg-tinted);
    border-radius: var(--radius-lg);
    border: var(--border-width-xs) solid var(--border-subtle);
  }

  .cta-enquiry--alt .cta-enquiry__card {
    background: var(--bg-surface-alt);
    border-color: transparent;
    text-align: center;
    align-items: center;
  }

  .cta-enquiry__title {
    font-family: var(--font-tailor-heading-stack);
    font-size: var(--text-prose-size-h3);
    font-weight: var(--heading-weight-h3);
    color: var(--text-heading);
    margin: 0 0 0.25rem;
  }

  .cta-enquiry__text {
    font-size: var(--text-prose-size-body);
    color: var(--text-body-muted);
    margin: 0;
  }

  /* Vertically stack primary CTA + secondary "approach" link with the
     same gap rhythm the card already uses. */
  .cta-enquiry__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-global-sm);
    align-items: center;
  }

  .cta-enquiry__secondary {
    font-size: var(--text-card-size-body);
  }

  @media (min-width: 768px) {
    .cta-enquiry__card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .cta-enquiry--alt .cta-enquiry__card {
      flex-direction: column;
    }
  }
</style>
