---
/**
 * CTA block [A12] — "Bring [topic] into your school"
 * Bottom-page CTA linking to services or training.
 * Used on landing pages [C3]. Target varies by landing page.
 *
 * Sept 2026: this used to render its own light card. It now delegates to
 * CtaClosing so every closing CTA on the site is the same dark band — the
 * props and call sites are unchanged.
 */
import CtaClosing from './CtaClosing.astro';

interface Props {
  topicTitle: string;
  /** delivery | training | drop-days | consultancy | rse-policy-curriculum-planning */
  serviceTarget: string | null;
}

const { topicTitle, serviceTarget } = Astro.props;

const targetMap: Record<string, { href: string; label: string }> = {
  delivery: { href: '/services/', label: 'Explore RSE delivery' },
  training: { href: '/services/rse-training/', label: 'RSE training' },
  'drop-days': { href: '/services/drop-days/', label: 'Drop days' },
  consultancy: { href: '/services/rse-policy-curriculum-planning/', label: 'RSE policy and curriculum planning' },
  'rse-policy-curriculum-planning': { href: '/services/rse-policy-curriculum-planning/', label: 'RSE policy and curriculum planning' },
};

const target = targetMap[serviceTarget || ''] || targetMap['training'];
---

<CtaClosing
  headingId="cta-bring-to-school-heading"
  title={`Bring ${topicTitle} into your school`}
  subtitle="Expert-led RSE sessions delivered directly to your students, or training for your staff to deliver with confidence."
  primaryHref={target.href}
  primaryLabel={target.label}
  secondaryHref="/contact/"
  secondaryLabel="Talk to us"
  ctaType="bring_to_school"
  serviceType={serviceTarget || 'training'}
/>
