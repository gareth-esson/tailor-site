---
/**
 * Shell for a full-window presenter screen (the Stages in Relationships
 * presenter view, shared over a video call or put on a projector).
 *
 * Deliberately not BaseLayout, for the same reason as StudioLayout: the
 * site header, footer, cookie banner, OtA search pill and analytics are
 * noise on a screen a whole group is watching. It loads the same
 * stylesheet and the same Lexend weights, so the design tokens and
 * typography are identical to everywhere else.
 *
 * Every page using it is noindex + nofollow.
 */
import '../styles/tailwind.css';
import '../styles/tailor-site-v2.css';
import '@fontsource/lexend/400.css';
import '@fontsource/lexend/600.css';
import '@fontsource/lexend/700.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="same-origin" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
