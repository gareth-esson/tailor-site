---
/**
 * About page [B2] — /about
 * Trust page: leadership bios, the wider delivery panel, how we
 * think, recent writing, and a soft contact door. Tailor layer.
 *
 * The §3 block is a stacked pair of split-layouts (one per leader)
 * followed by a short note about the freelance specialist network
 * we draw on for drop days, twilight INSETs, and bespoke programmes.
 * Portraits gate on file existence at build time — drop the .webp
 * (and the -800 variants from optimize-hero-images.mjs) into
 * public/images and the headshot replaces the initials fallback.
 */
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBlogPosts } from '../lib/content';
import type { BlogPost } from '../lib/types';
import HeroImage from '../components/HeroImage.astro';
import { site, founderJsonLd, breadcrumbJsonLd } from '../lib/site';

// --- Leadership data ---
//
// `portrait` is the original .webp path. It only renders if both the
// original and the -800.webp variant exist on disk — otherwise the
// initials fallback shows. Run scripts/optimize-hero-images.mjs after
// dropping in a new portrait to generate the responsive variants.

interface TeamMember {
  id: string;
  name: string;
  role: string;
  credentials: string;
  bio: string[];
  portrait: string | null;
  portraitAlt: string | null;
  linkedIn?: string;
  eyebrow: string;
}

function portraitIfReady(src: string): string | null {
  const publicDir = path.resolve(process.cwd(), 'public');
  const exists = (p: string) => fs.existsSync(path.join(publicDir, p.replace(/^\//, '')));
  const variant = src.replace(/\.webp$/, '-800.webp');
  return exists(src) && exists(variant) ? src : null;
}

const team: TeamMember[] = [
  {
    id: 'about-founder-title',
    eyebrow: 'Founder',
    name: 'Gareth Esson',
    role: 'Founder & RSE Specialist',
    credentials: 'Brook-accredited trainer · Enhanced DBS',
    bio: [
      "Gareth founded Tailor Education in 2016 after seven years at Brook as an Advanced Education and Training Practitioner — designing tailored RSE programmes for high-risk and marginalised young people, and delivering Brook-accredited Train-the-Trainer to professionals across the youth, education, and health workforce.",
      "He leads Tailor's curriculum and editorial work alongside Sheila and the wider panel of specialists, taking every scheme of work and every page on this site through the same test any teacher would ask: would I teach this tomorrow, with a real class, and stand behind every word?",
      "Alongside Tailor he runs multi-agency youth-engagement programmes with Rathbone Society and The Norwood Consortium, working with local authorities, charities, and community groups. It keeps the strategic side of the work honest about what actually happens at delivery.",
    ],
    portrait: portraitIfReady('/images/portrait-gareth.webp'),
    portraitAlt: 'Gareth Esson, founder of Tailor Education',
    linkedIn: 'https://www.linkedin.com/in/gareth-esson-6886635a/',
  },
  {
    id: 'about-cofounder-title',
    eyebrow: 'Co-Director',
    name: 'Sheila Daley-Danvers',
    role: 'Co-Director & Safeguarding Lead',
    credentials: 'ICQ L3 Management · MHFA',
    bio: [
      "Sheila joined Brook London in 2003 as an Education Outreach Worker, where she spent eight years designing and delivering RSE in Camden and Lambeth schools, and training adults and professionals across the youth workforce. She moved to Guys & St Thomas' as a Specialist Sexual Health Outreach Worker, running a caseload of school-aged clients and embedding sexual-health support into school-based provision.",
      "For the next decade at St Michaels Fellowship she carried a young-parent caseload through child-protection and child-in-need plans, wrote case-conference and court reports, and supervised contact between estranged parents and children. She finished her time there as Outreach Service Manager, leading a team of practitioners, partnering with statutory and voluntary services, and keeping the work culturally responsive to the families it served.",
      "She brings that combination to Tailor: classroom-tested RSE practice, deep safeguarding instincts, and the perspective of someone who has sat in the case conferences our resources are designed to help prevent. She's a Caring Dads trainer, a Lego Serious Play facilitator, a qualified doula, and Mental Health First Aid certified.",
    ],
    portrait: portraitIfReady('/images/portrait-sheila.webp'),
    portraitAlt: 'Sheila Daley-Danvers, Co-Director of Tailor Education',
  },
];

// --- Featured blog posts ---

const FEATURED_SLUGS: string[] = [
  // [COPY TBD — 3 slugs chosen for the About page]
];

const allPosts = await getBlogPosts();

const resolvedFeatured = FEATURED_SLUGS
  .map((slug) => allPosts.find((p) => p.slug === slug))
  .filter((p): p is BlogPost => p !== undefined);

// Back-fill up to 3 from newest-first, de-duplicated.
const byDate = [...allPosts].sort((a, b) => {
  const ad = a.publishedDate ? new Date(a.publishedDate).getTime() : 0;
  const bd = b.publishedDate ? new Date(b.publishedDate).getTime() : 0;
  return bd - ad;
});

const featuredPosts: BlogPost[] = [...resolvedFeatured];
for (const p of byDate) {
  if (featuredPosts.length >= 3) break;
  if (!featuredPosts.some((f) => f.id === p.id)) featuredPosts.push(p);
}
const displayPosts = featuredPosts.slice(0, 3);

// --- Helpers ---

function initials(name: string): string {
  const parts = name.trim().split(/\s+/);
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

function formatDate(iso: string | null): string | null {
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  return new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(d);
}

function deriveExcerpt(post: BlogPost, max = 140): string {
  const source = (post.metaDescription || post.excerpt || '').trim();
  if (source.length <= max) return source;
  const slice = source.slice(0, max - 1);
  const lastSpace = slice.lastIndexOf(' ');
  return (lastSpace > 40 ? slice.slice(0, lastSpace) : slice) + '…';
}

// Dev-time loud failure: portrait set but no alt is an accessibility bug.
if (import.meta.env.DEV) {
  for (const m of team) {
    if (m.portrait && !m.portraitAlt) {
      console.warn(
        `[about.astro] ${m.name} portrait set but no portraitAlt. Alt text is required for informational portraits.`,
      );
    }
  }
}

// --- SEO ---

const description =
  'About Tailor Education — a community-interest company founded by Gareth Esson and co-led with Sheila Daley-Danvers, delivering specialist RSE content, training, and support to UK schools.';

// Page schema graph: AboutPage + Person (founder + co-director) + breadcrumb.
// Sitewide Organization is emitted by BaseLayout, so we don't duplicate it.
// The founder Person is the canonical one (referenced from site.ts and the
// Organization graph); Sheila is added inline so /about declares both
// leaders without forcing wider edits to the sitewide schema constants.
const cofounderJsonLd = {
  '@type': 'Person',
  '@id': `${site.url}/about#about-cofounder-title`,
  name: 'Sheila Daley-Danvers',
  url: `${site.url}/about#about-cofounder-title`,
  jobTitle: 'Co-Director & Safeguarding Lead',
  knowsAbout: [
    'Relationships and Sex Education',
    'Sexual Health',
    'Safeguarding',
    'Child Protection',
    'Parent Engagement',
    'Mental Health First Aid',
  ],
  worksFor: { '@id': `${site.url}/#organization` },
};

const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': 'https://tailoreducation.org.uk/about#aboutpage',
      name: 'About Tailor Education',
      description,
      mainEntity: { '@id': 'https://tailoreducation.org.uk/about#about-founder-title' },
      isPartOf: { '@id': 'https://tailoreducation.org.uk/#website' },
    },
    founderJsonLd(),
    cofounderJsonLd,
    breadcrumbJsonLd([{ name: 'About', path: '/about' }]),
  ],
};
---

<BaseLayout
  title="About Tailor Education | RSE specialists for UK schools"
  description={description}
  canonicalPath="/about"
  jsonLd={aboutJsonLd}
>
  <!-- §1 Hero -->
  <header class="about-hero">
    <div class="about-hero__inner">
      <div class="about-hero__text">
        <span class="about-hero__eyebrow">About Tailor Education</span>
        <h1 class="about-hero__title">RSE built by teachers, trusted by schools.</h1>
        <p class="about-hero__lede">
          Tailor Education is a community-interest company delivering expert
          relationships and sex education resources, training, and support to UK
          schools. Everything we publish is written by practising educators and
          aligned to statutory guidance.
        </p>
      </div>
    </div>
  </header>

  <div class="about-page">
    <!-- §2 Who we are -->
    <section class="about-intro">
      <div class="about-intro__inner">
        <h2 class="about-intro__title">Tailor Education</h2>
        <p class="about-intro__para">
          Tailor Education exists to make high-quality relationships and sex
          education feel deliverable in every classroom, not just the ones
          with a specialist on staff. We build the resources, the training,
          and the planning support that let schools teach RSE with confidence,
          grounded in DfE statutory guidance and the PSHE Association
          Programme of Study.
        </p>
        <p class="about-intro__para">
          Tailor Education is the trading name of Tailor Learning CIC, a <a
            href="https://find-and-update.company-information.service.gov.uk/company/17239965"
            rel="noopener noreferrer"
          >community-interest company</a> registered in England (No. 17239965):
          any surplus we generate is committed, by statute, to the community
          purpose we were founded for. That's a structure, not a slogan, it
          shapes who we answer to and how we choose what to work on next.
        </p>
        <p class="about-intro__para">
          We believe young people deserve honest, inclusive, age-appropriate
          RSE, and teachers deserve the tools and the confidence to deliver
          it. Every page we publish and every training session we run is
          measured against that belief.
        </p>
      </div>
    </section>

    <!-- §3 Our team -->
    <section class="about-team" aria-labelledby="about-team-title">
      <div class="about-team__inner">
        <header class="about-team__heading">
          <h2 id="about-team-title" class="about-team__title">Our team</h2>
          <p class="about-team__intro">
            Tailor is led by Gareth and Sheila, and backed by a panel of
            practising specialists we draw on to deliver training, drop
            days, and bespoke programmes at scale.
          </p>
        </header>

        {team.map((person, index) => (
          <article
            class:list={[
              'about-team__member',
              'split-layout',
              index % 2 === 0 && 'split-layout--image-left',
            ]}
            aria-labelledby={person.id}
          >
            {/* DOM order is text-first per .split-layout convention; the
                --image-left modifier on even-indexed members visually flips
                the figure to the left so the layout alternates. */}
            <div class="about-team__body split-layout__text">
              <span class="about-team__eyebrow">{person.eyebrow}</span>
              {person.linkedIn ? (
                <h3 id={person.id} class="about-team__name">
                  <a href={person.linkedIn} rel="noopener noreferrer" target="_blank">
                    {person.name}<span class="sr-only"> (opens in new tab)</span>
                  </a>
                </h3>
              ) : (
                <h3 id={person.id} class="about-team__name">{person.name}</h3>
              )}
              <p class="about-team__role">{person.role}</p>
              <p class="about-team__credentials">{person.credentials}</p>
              {person.bio.map((para) => (
                <p class="about-team__para">{para}</p>
              ))}
            </div>
            <figure class="about-team__portrait split-layout__media">
              {person.portrait ? (
                <HeroImage
                  src={person.portrait}
                  alt={person.portraitAlt || `Portrait of ${person.name}`}
                  width={1000}
                  height={1000}
                  sizes="(min-width: 1024px) 24rem, (min-width: 768px) 18rem, 14rem"
                />
              ) : (
                <div class="about-team__portrait-fallback" aria-hidden="true">
                  {initials(person.name)}
                </div>
              )}
            </figure>
          </article>
        ))}

        <p class="about-team__network">
          Around that core sit around eight freelance specialists — RSE
          teachers, sexual health practitioners, SEND leads, parent-engagement
          workers — who we bring in for delivery at scale. Need six facilitators
          for a Year 9 drop day, three trainers for a twilight INSET, or a
          SEND-adapted scheme written by someone who teaches it weekly?
          That's the team you're hiring, not just the two bios above.
        </p>
      </div>
    </section>

    <!-- §4 Our approach -->
    <section class="about-approach">
      <div class="about-approach__inner">
        <h2 class="about-intro__title">Our approach</h2>
        <p class="about-intro__para">
          Our content is written by practising educators, aligned to DfE, PSHE
          Association, and UNESCO frameworks, and designed around
          disclosure-aware activity design. If you want to see how that plays
          out in curriculum, training, and classroom practice, we've written
          it up in full.
        </p>
        <a href="/our-approach" class="btn btn--std btn--tint has-icon-hover about-approach__cta w-full sm:w-auto">
          Read about our approach
        </a>
      </div>
    </section>

    {displayPosts.length > 0 && (
      <!-- §5 From our blog -->
      <section class="about-blog" aria-labelledby="about-blog-title">
        <div class="about-blog__inner">
          <h2 id="about-blog-title" class="about-blog__title">From our blog</h2>
          <p class="about-blog__intro">
            A taste of how we think, in long form.
          </p>
          <ul class="about-blog__grid" role="list">
            {displayPosts.map((post) => {
              const category = post.targetAudience || post.topics[0]?.title || null;
              const excerpt = deriveExcerpt(post);
              const date = formatDate(post.publishedDate);
              const topics = post.topics.slice(0, 3);
              const extraTopicCount = Math.max(0, post.topics.length - topics.length);
              return (
                <li class="about-blog__item">
                  <a href={`/blog/${post.slug}`} class="blog-index-card">
                    <div class="blog-index-card__image">
                      {post.featuredImage ? (
                        <img
                          src={post.featuredImage}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="blog-index-card__image-fallback" aria-hidden="true"></div>
                      )}
                    </div>
                    <div class="blog-index-card__body">
                      {category && (
                        <div class="blog-index-card__eyebrow">{category}</div>
                      )}
                      <h3 class="blog-index-card__title">{post.title}</h3>
                      {excerpt && (
                        <p class="blog-index-card__excerpt">{excerpt}</p>
                      )}
                      <div class="blog-index-card__meta">
                        {post.author && <span>{post.author}</span>}
                        {post.author && date && <span aria-hidden="true"> · </span>}
                        {date && <time datetime={post.publishedDate || undefined}>{date}</time>}
                      </div>
                      {topics.length > 0 && (
                        <div class="blog-index-card__topics">
                          {topics.map((t) => (
                            <span class="blog-index-card__topic">{t.title}</span>
                          ))}
                          {extraTopicCount > 0 && (
                            <span class="blog-index-card__topic blog-index-card__topic--more">
                              +{extraTopicCount} more
                            </span>
                          )}
                        </div>
                      )}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
          <div class="about-blog__footer">
            <a href="/blog/" class="btn btn--std btn--tint has-icon-hover w-full sm:w-auto">
              View all posts
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- §6 Get in touch -->
    <section class="about-cta">
      <div class="about-cta__inner">
        <div class="about-cta__card">
          <h2 class="about-cta__title">Work with us</h2>
          <p class="about-cta__body">
            Training, delivery, bespoke planning: drop us a note and we'll come
            back within a working day.
          </p>
          <a href="/contact" class="btn btn--std btn--primary has-icon-hover w-full sm:w-auto">
            Get in touch
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page { background: var(--bg-page); }

  /* -------------------------------------------------------------------- */
  /* §1 Hero                                                              */
  /* -------------------------------------------------------------------- */
  .about-hero {
    width: 100%;
    background: var(--bg-tinted);
    border-bottom: var(--border-width-xs) solid var(--border-subtle);
    padding: var(--space-struct-y-base) var(--space-global-gutter);
  }

  .about-hero__inner {
    margin-inline: auto;
    width: 100%;
    max-width: var(--container-max-shell);
  }

  .about-hero__text {
    max-width: var(--container-max-hero-text);
  }

  .about-hero__eyebrow {
    display: block;
    font-family: var(--font-tailor-body-stack);
    font-size: var(--text-card-size-body);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--section-eyebrow-ls);
    color: var(--brand-accent-text);
    margin: 0 0 var(--space-global-xs);
  }

  .about-hero__title {
    font-family: var(--font-tailor-heading-stack);
    font-size: var(--text-display-size-h1);
    font-weight: var(--heading-weight-h1);
    line-height: var(--lh-display);
    color: var(--text-heading);
    margin: 0 0 var(--space-global-sm);
  }

  .about-hero__lede {
    font-family: var(--font-tailor-body-stack);
    font-size: var(--text-prose-size-lede);
    font-weight: var(--font-weight-regular);
    line-height: var(--lh-prose);
    color: var(--text-body);
    margin: 0;
  }

  /* -------------------------------------------------------------------- */
  /* §2 Intro / §4 Approach (shared prose typography)                     */
  /* -------------------------------------------------------------------- */
  .about-intro,
  .about-approach {
    width: 100%;
    padding: var(--space-struct-y-base) var(--space-global-gutter);
  }

  .about-intro__inner,
  .about-approach__inner {
    margin-inline: auto;
    width: 100%;
    max-width: var(--container-max-prose);
  }

  .about-intro__title {
    font-family: var(--font-tailor-heading-stack);
    font-size: var(--text-prose-size-h2);
    font-weight: var(--heading-weight-h2);
    line-height: var(--lh-heading);
    color: var(--text-heading);
    margin: 0 0 var(--space-global-md);
  }

  .about-intro__para {
    font-family: var(--font-tailor-body-stack);
    font-size: var(--text-prose-size-body);
    font-weight: var(--font-weight-regular);
    line-height: var(--lh-prose);
    color: var(--text-body);
    margin: 0 0 var(--space-global-md);
  }

  .about-intro__para:last-child { margin-bottom: 0; }

  .about-approach__cta {
    margin-top: var(--space-global-md);
    align-self: flex-start;
  }

  /* -------------------------------------------------------------------- */
  /* §3 Our team                                                          */
  /* -------------------------------------------------------------------- */
  .about-team {
    width: 100%;
    background: var(--bg-page);
    padding: var(--space-struct-y-base) var(--space-global-gutter);
  }

  .about-team__inner {
    margin-inline: auto;
    width: 100%;
    max-width: var(--container-max-shell);
    display: flex;
    flex-direction: column;
    gap: var(--space-global-2xl);
  }

  .about-team__heading {
    max-width: var(--container-max-prose);
    display: flex;
    flex-direction: column;
    gap: var(--space-global-sm);
  }

  .about-team__title {
    font-family: var(--font-tailor-heading-stack);
    font-size: var(--text-prose-size-h2);
    font-weight: var(--heading-weight-h2);
    line-height: var(--lh-heading);
    color: var(--text-heading);
    margin: 0;
  }

  .about-team__intro {
    font-family: var(--font-tailor-body-stack);
    font-size: var(--text-prose-size-body);
    font-weight: var(--font-weight-regular);
    line-height: var(--lh-prose);
    color: var(--text-body);
    margin: 0;
  }

  /* Per-member portrait aspect (taller than the split-layout default 4/3) */
  .about-team__member {
    --split-media-aspect: 4 / 5;
  }

  .about-team__portrait {
    background: var(--bg-surface-alt);
  }

  .about-team__portrait img {
    object-position: center top;
  }

  .about-team__portrait-fallback {
    width: 100%;
    height: 100%;
    background: var(--bg-tinted);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-tailor-heading-stack);
    font-size: clamp(3rem, 6vw + 1rem, 5rem);
    font-weight: var(--font-weight-bold);
    color: var(--brand-accent-text);
    letter-spacing: -0.02em;
  }

  .about-team__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-global-sm);
  }

  .about-team__eyebrow {
    display: block;
    font-family: var(--font-tailor-body-stack);
    font-size: var(--text-card-size-body);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--section-eyebrow-ls);
    color: var(--brand-accent-text);
  }

  .about-team__name {
    font-family: var(--font-tailor-heading-stack);
    font-size: var(--text-prose-size-h3);
    font-weight: var(--heading-weight-h3);
    line-height: var(--lh-heading);
    color: var(--text-heading);
    margin: 0;
  }

  .about-team__name a {
    color: inherit;
    text-decoration: none;
  }

  .about-team__name a:hover,
  .about-team__name a:focus-visible {
    color: var(--brand-accent-text);
    text-decoration: underline;
  }

  .about-team__role {
    font-family: var(--font-tailor-body-stack);
    font-size: var(--text-prose-size-body);
    font-weight: var(--font-weight-medium);
    line-height: var(--lh-card);
    color: var(--brand-accent-text);
    margin: 0;
  }

  .about-team__credentials {
    font-family: var(--font-tailor-body-stack);
    font-size: var(--text-card-size-h6);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--card-eyebrow-ls);
    color: var(--text-body-muted);
    line-height: var(--lh-card);
    margin: 0;
  }

  .about-team__para {
    font-family: var(--font-tailor-body-stack);
    font-size: var(--text-prose-size-body);
    font-weight: var(--font-weight-regular);
    line-height: var(--lh-prose);
    color: var(--text-body);
    margin: var(--space-global-sm) 0 0;
  }

  .about-team__network {
    max-width: var(--container-max-prose);
    font-family: var(--font-tailor-body-stack);
    font-size: var(--text-prose-size-body);
    font-weight: var(--font-weight-regular);
    line-height: var(--lh-prose);
    color: var(--text-body);
    margin: 0;
  }

  /* -------------------------------------------------------------------- */
  /* §4 Approach — layout of intro block                                  */
  /* (typography shared with §2 via .about-intro__title/__para classes)    */
  /* -------------------------------------------------------------------- */
  .about-approach__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* -------------------------------------------------------------------- */
  /* §5 From our blog                                                     */
  /* -------------------------------------------------------------------- */
  .about-blog {
    width: 100%;
    background: var(--bg-surface-alt);
    padding: var(--space-struct-y-base) var(--space-global-gutter);
  }

  .about-blog__inner {
    margin-inline: auto;
    width: 100%;
    max-width: var(--container-max-shell);
  }

  .about-blog__title {
    font-family: var(--font-tailor-heading-stack);
    font-size: var(--text-prose-size-h2);
    font-weight: var(--heading-weight-h2);
